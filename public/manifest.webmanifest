{
  "id": "/app",
  "name": "Kristu mu Nyimbo",
  "short_name": "Kristu mu Nyimbo",
  "description": "Multilingual Seventh-day Adventist Hymnal (Bemba, Tonga, Chewa, English) and English Bible with offline worship support.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#0B2E6B",
  "background_color": "#FFFFFF",
  "categories": ["books", "lifestyle", "music"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
